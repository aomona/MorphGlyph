{
  "name": "morphglyph",
  "version": "0.2.0",
  "description": "Manim-inspired glyph transformations for React",
  "type": "module",
  "license": "MIT",
  "author": "aomona",
  "homepage": "https://aomona.github.io/MorphGlyph/",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/aomona/MorphGlyph.git",
    "directory": "packages/morphglyph"
  },
  "bugs": {
    "url": "https://github.com/aomona/MorphGlyph/issues"
  },
  "files": [
    "dist",
    "assets",
    "README.md",
    "LICENSE"
  ],
  "main": "./dist/index.js",
